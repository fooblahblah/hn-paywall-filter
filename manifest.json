{
  "manifest_version": 3,
  "name": "HN Paywall Filter",
  "version": "0.1.15",
  "description": "Hides Hacker News stories that link to paywalled or sign-up-gated sites.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://news.ycombinator.com/*"],
      "js": ["src/seed.js", "src/psl.js", "src/shared.js", "src/hn.js"],
      "css": ["src/hn.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "HN Paywall Filter"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
